# DLT Secrets Template
# This file contains SENSITIVE credentials
# NEVER commit to version control - add to .gitignore

# PostgreSQL destination credentials
[destination.postgres.credentials]
host = "localhost"
port = 5432
database = "my_database"
username = "my_user"
password = "my_password"  # Use environment variables in production

# BigQuery destination credentials (alternative)
[destination.bigquery.credentials]
project_id = "my-project-id"
# For service account authentication:
# location = "/path/to/service-account-key.json"

# Snowflake destination credentials (alternative)
[destination.snowflake.credentials]
account = "my_account"
user = "my_user"
password = "my_password"
database = "my_database"
warehouse = "my_warehouse"
role = "my_role"

# Source-specific credentials
[sources.my_source.credentials]
# Example: API credentials
api_key = "your_api_key_here"
api_secret = "your_api_secret_here"

# Example: Database source credentials
# [sources.my_db_source.credentials]
# host = "source-db.example.com"
# port = 5432
# database = "source_db"
# username = "readonly_user"
# password = "readonly_password"

# AWS S3 credentials (for filesystem source with S3)
[sources.filesystem.credentials]
aws_access_key_id = "your_access_key"
aws_secret_access_key = "your_secret_key"

# Google Cloud Storage credentials (alternative)
# [sources.filesystem.credentials]
# project_id = "my-gcp-project"
# client_email = "my-service-account@project.iam.gserviceaccount.com"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production Best Practice: Use Environment Variables
# Instead of hardcoding secrets, reference them like:
# password = "$POSTGRES_PASSWORD"
# Then set POSTGRES_PASSWORD in your environment
