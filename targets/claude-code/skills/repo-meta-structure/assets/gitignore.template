# _meta dir — ignored by default, durable items tracked via negation.
# MUST be `_meta/*` (not `_meta/`): git cannot negate paths inside a
# wholly-ignored directory, so the negations only work with the /* form.
_meta/*
!_meta/plans/
!_meta/README.md
!_meta/HANDOFF.md
!_meta/mise-en-place.yml
# scaffolded dirs: track only the .gitkeep so the dirs survive a fresh clone;
# content stays local (operations/ especially — secrets are never tracked).
# Each dir needs the triplet: re-include the dir, ignore its content, keep the keep.
!_meta/_archive/
_meta/_archive/*
!_meta/_archive/.gitkeep
!_meta/briefings/
_meta/briefings/*
!_meta/briefings/.gitkeep
!_meta/operations/
_meta/operations/*
!_meta/operations/.gitkeep
!_meta/research/
_meta/research/*
!_meta/research/.gitkeep
# desk-toolkit bytecode: the plans negation re-includes everything under the desk,
# so without this a `git add -A` commits _utils/ .pyc files (last match wins).
_meta/plans/_utils/__pycache__/

# .claude — track memory/, rules/, skills/, settings.json; ignore machine-local
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store

