{
  // main is the CI-published distribution branch (ADR 0007/0008) — never commit to it.
  // VSCode cannot block a branch *checkout*; the .git/hooks/post-checkout warning and the
  // .claude/hooks/no-main-checkout guard cover that.
  "git.branchProtection": ["main"],
  "git.branchProtectionPrompt": "alwaysPrompt"
}
