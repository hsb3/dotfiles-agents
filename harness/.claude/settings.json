{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "/Users/henry/.claude/CLAUDE.md",
    "/Users/henry/Developer/agent-memory/**",
    "/Users/henry/.claude/rules/**",
    "/Users/henry/dotfiles/claude-code/.claude/rules/**",
    "/Users/henry/Developer/tmp-dotfiles-agents-cleanup/*.md",
    "/Users/henry/Developer/tmp-dotfiles-agents-cleanup/.claude/**",
    "/Users/henry/Developer/*.md",
    "/Users/henry/Developer/.claude/**"
  ],
  "enabledPlugins": {
    "groma-backlog-greenfield@groma-extras": true
  },
  "extraKnownMarketplaces": {
    "groma-extras": {
      "source": {
        "source": "directory",
        "path": "/Users/henry/Developer/backlog-groma-playbook"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/henry/.claude/hooks/herdr-agent-state.sh' session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/henry/Developer/tmp-dotfiles-agents-cleanup/seed/confine.py /Users/henry/Developer/backlog-groma-playbook/plugin/groma-backlog-greenfield"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch",
      "Edit(./.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~"
      ],
      "allowRead": [
        ".",
        "/Users/henry/Developer/backlog-groma-playbook/plugin/groma-backlog-greenfield",
        "~/.local/share/groma-release",
        "~/.bun",
        "~/.groma",
        "~/.config/mise",
        "~/.local/share/mise",
        "~/.local/bin",
        "~/go",
        "~/Library/Caches/go-build",
        "~/.config/git",
        "~/dotfiles/git/.config/git",
        "~/Library/Application Support/go",
        "~/.local/share/agent-sandbox"
      ],
      "allowWrite": [
        ".",
        "~/.bun/install/cache",
        "~/go/pkg/mod",
        "~/Library/Caches/go-build",
        "~/.groma/cache",
        "~/.local/state/mise",
        "/var/folders/4l/vwxc3x7d1f15vtqvmpq6ddl40000gn/T"
      ]
    },
    "network": {
      "deniedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ],
      "allowLocalBinding": true
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "env": {
    "PATH": "/Users/henry/.local/share/agent-sandbox/bin:/Users/henry/.local/share/groma-release/0.6.6+hsb3.eecf3502:/Users/henry/.local/share/mise/shims:/Users/henry/.local/share/mise/installs/node/26/bin:/Users/henry/.local/share/mise/installs/go/1.27.2/bin:/Users/henry/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "GIT_CONFIG_GLOBAL": "/dev/null"
  },
  "skipDangerousModePermissionPrompt": true
}