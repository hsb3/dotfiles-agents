{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-main-checkout/hook.py",
            "timeout": 10,
            "statusMessage": "Checking for main-branch checkout"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "workbench": {
      "source": { "source": "directory", "path": "./.claude/plugins" }
    }
  },
  "enabledPlugins": {
    "plugin-dev@workbench": true,
    "skill-creator@workbench": true,
    "mcp-server-dev@workbench": false,
    "code-desk@dotfiles-agents": false,
    "dataviz@dotfiles-agents": false,
    "diagrams@dotfiles-agents": false,
    "pptx-themes@dotfiles-agents": false,
    "github-project-board@dotfiles-agents": false
  }
}
