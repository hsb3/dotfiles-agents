{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-main-checkout/hook.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking for main-branch checkout"
          }
        ]
      }
    ]
  }
}
