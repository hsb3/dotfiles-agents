{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(git diff:*)",
      "Read(src/**)",
      "Edit(src/**)",
      "WebFetch(domain:docs.example.com)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(secrets/**)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "../shared-lib"
    ]
  }
}
