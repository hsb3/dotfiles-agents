# --- Claude Code (track memory/rules/settings; ignore machine-local/transient) ---
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store

# --- OS / editor ---
.DS_Store
*.swp

# --- secrets ---
.env
.env.*
!.env.example

# --- _meta: ignore by default, track durable items via negation ---
_meta/*
!_meta/README.md
!_meta/HANDOFF.md
!_meta/plans/
!_meta/plans/**

# --- Python (after the _meta negation so toolkit caches stay untracked) ---
__pycache__/
*.pyc
