# --- Claude Code (track memory/rules/settings; ignore machine-local/transient) ---
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store

# --- OS / editor ---
.DS_Store
*.swp

# --- secrets ---
.env
.env.*
!.env.example

# --- _meta: ignore by default, track durable items via negation ---
_meta/*
!_meta/README.md
!_meta/HANDOFF.md
!_meta/mise-en-place.yml
!_meta/plans/
!_meta/plans/**
# scaffolded dirs: track only the .gitkeep so the dirs survive a fresh clone;
# content stays local (operations/ especially — secrets are never tracked)
!_meta/briefings/
_meta/briefings/*
!_meta/briefings/.gitkeep
!_meta/operations/
_meta/operations/*
!_meta/operations/.gitkeep
!_meta/research/
_meta/research/*
!_meta/research/.gitkeep
!_meta/_archive/
!_meta/_archive/**
_meta/_archive/**/.DS_Store
_meta/_archive/.DS_Store

# --- Python (after the _meta negation so toolkit caches stay untracked) ---
__pycache__/
*.pyc
