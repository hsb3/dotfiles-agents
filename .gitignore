# --- Claude Code (track memory/rules/settings; ignore machine-local/transient) ---
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store

# --- OS / editor ---
.DS_Store
*.swp

# --- secrets ---
.env
.env.*
!.env.example

# --- _meta: tracked by default (ADR-0006); operations/ holds secrets — its content is never tracked ---
_meta/operations/*
!_meta/operations/.gitkeep

# --- extender-db: live PocketBase database is machine-local; scripts/README are tracked.
# pb_migrations/ is PocketBase's auto-generated schema journal — schema.py is the one
# rebuild path (CHARTER.md decision 2); tracking both would create a second schema source.
_meta/extender-db/pb_data/
_meta/extender-db/pb_migrations/

# --- Python ---
__pycache__/
*.pyc
.ruff_cache/

# --- runtime logs (e.g. foreman-kit subagent-telemetry -> logs/delegation.jsonl) ---
logs/
