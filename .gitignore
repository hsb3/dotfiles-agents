# --- OS / editor ---
.DS_Store
*.swp

# --- secrets ---
.env
.env.*
!.env.example

# --- _meta: tracked by default (ADR-0006); operations/ holds secrets — its content is never tracked ---
_meta/operations/*
!_meta/operations/.gitkeep

# --- extender-db, at evals/ (evals/_structure/CHARTER.md decisions 2+4):
# data.db is tracked (small, private repo — state travels with the repo); transient
# siblings are not: auxiliary.db is request logs, WAL/SHM are live journals, types.d.ts is
# generated. pb_migrations/ is PocketBase's auto-generated schema journal — schema.py is
# the one rebuild path; tracking both would create a second schema source.
evals/pb_data/*
!evals/pb_data/data.db
# file-field blobs (harness artifacts) must travel with the repo like data.db does (#174)
!evals/pb_data/storage/
evals/pb_migrations/

# --- Python ---
__pycache__/
*.pyc
.ruff_cache/

# --- runtime logs (e.g. foreman-kit subagent-telemetry -> logs/delegation.jsonl) ---
logs/
*.log

# --- agent harness (harness/ uv project) — runtime artifacts, never tracked
# (results.jsonl IS tracked: battle-test evidence, DESIGN §8-D3). Temp workspaces
# default to the system tempdir; harness/workspaces/ is a defensive ignore. ---
harness/runs/
harness/workspaces/
harness/.venv/
# weekly campaign runner logs (defensive; the global *.log already covers the files)
harness/campaign-logs/

# >>> cc-project-memory (managed) >>>
# narrow-ignore: ignore only machine-local/transient; track everything else under .claude/
# (memory/, rules/, settings.json stay tracked & transferable)
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store
# <<< cc-project-memory (managed) <<<
