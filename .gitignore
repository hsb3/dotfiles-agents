# --- Claude Code (track memory/rules/settings; ignore machine-local/transient) ---
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store

# --- OS / editor ---
.DS_Store
*.swp

# --- secrets ---
.env
.env.*
!.env.example

# --- _meta: tracked by default (ADR-0006); operations/ holds secrets — its content is never tracked ---
_meta/operations/*
!_meta/operations/.gitkeep

# --- extender-db, at evals/ (evals/_structure/CHARTER.md decisions 2+4):
# data.db is tracked (small, private repo — state travels with the repo); transient
# siblings are not: auxiliary.db is request logs, WAL/SHM are live journals, types.d.ts is
# generated. pb_migrations/ is PocketBase's auto-generated schema journal — schema.py is
# the one rebuild path; tracking both would create a second schema source.
evals/pb_data/*
!evals/pb_data/data.db
evals/pb_migrations/

# --- Python ---
__pycache__/
*.pyc
.ruff_cache/

# --- runtime logs (e.g. foreman-kit subagent-telemetry -> logs/delegation.jsonl) ---
logs/
*.log